{
    "name": "Bun Development",
    "dockerComposeFile": "compose.yaml",
    "service": "dev",
    "workspaceFolder": "/workspace",
    "customizations": {
        "vscode": {
            "extensions": [
                "oven.bun-vscode",
                "svelte.svelte-vscode",
                "stivo.tailwind-fold",
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode"
            ]
        }
    },
    "forwardPorts": [
        5173,
        5432
    ],
    "remoteUser": "bun"
}
